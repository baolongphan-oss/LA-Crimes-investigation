    <worksheet name='Crime Status'>
      <table>
        <view>
          <datasources>
            <datasource caption='cleaned_crime_data.csv+ (Multiple Connections)' name='federated.0nrznqi1exvl5b15d572i0z7l15e' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Top Crimes' datatype='integer' default-format='N' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='20'>
              <calculation class='tableau' formula='20' />
              <range granularity='5' max='25' min='10' />
            </column>
            <column caption='Expand or Collapse' datatype='string' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='&quot;Expand&quot;'>
              <calculation class='tableau' formula='&quot;Expand&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0nrznqi1exvl5b15d572i0z7l15e'>
            <column caption='Subset Labels (Crimes)' datatype='string' name='[Calculation_4933271222743216128]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Top N Crimes]&#10;THEN &quot;Top &quot; + str([Parameters].[Parameter 1]) + &quot; Crimes&quot;&#10;ELSE &quot;Others&quot;&#10;END' />
            </column>
            <column caption='Crimes Calc' datatype='string' name='[Calculation_4933271222744518657]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2]=&quot;Collapse&quot; THEN&#10;IF [Top N Crimes]&#10;THEN [Crime Desc]&#10;ELSE &quot;Others&quot; END&#10;ELSE [Crime Desc] END' />
            </column>
            <column caption='Dummy Axis' datatype='integer' name='[Calculation_4933271222759886853]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MIN(1)' />
            </column>
            <column datatype='string' name='[Crime Desc]' role='dimension' type='nominal' />
            <column datatype='date' name='[Date Reported]' role='dimension' type='ordinal' />
            <column caption='Crime Records' datatype='string' default-role='measure' default-type='quantitative' name='[Div Record No]' role='dimension' type='nominal' />
            <column datatype='string' name='[Status Desc]' role='dimension' type='nominal' />
            <column datatype='string' name='[Weapon Desc]' role='dimension' type='nominal' />
            <column-instance column='[Div Record No]' derivation='CountD' name='[ctd:Div Record No:qk]' pivot='key' type='quantitative' />
